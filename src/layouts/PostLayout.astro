---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  description?: string;
  canonical?: string;
}
const { title, date, updated, description, canonical } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <article class="post">
    <h1>{title}</h1>
    <p class="post-date">
      <time datetime={date.toISOString().slice(0, 10)}>{fmt(date)}</time>
      {updated && <> · Updated <time datetime={updated.toISOString().slice(0, 10)}>{fmt(updated)}</time></>}
    </p>
    <slot />
  </article>
</BaseLayout>
