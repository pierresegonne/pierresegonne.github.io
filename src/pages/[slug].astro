---
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { extraKatexFonts } from '../utils/katex-fonts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// Only posts with maths load the KaTeX stylesheet.
const math = post.body?.includes('$$') ?? false;
const mathFonts = math ? extraKatexFonts(post.rendered?.html) : [];
---
<PostLayout {...post.data} math={math} mathFonts={mathFonts}>
  <Content />
</PostLayout>
