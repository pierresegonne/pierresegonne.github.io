{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/Normalizing_flows/",
        "http://localhost/How_many_oil_fields/",
        "http://localhost/Tutorial_react_form/",
        "http://localhost/about/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 0
          }
        ],
        "resource-summary:document:size": [
          "warn",
          {
            "maxNumericValue": 30720
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    }
  }
}
